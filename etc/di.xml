<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
	<type name="Magento\Framework\Console\CommandList">
		<arguments>
			<argument name="commands" xsi:type="array">
				<item name="bigbridge_product_import" xsi:type="object">BigBridge\ProductImport\Console\Command\ProductImportCommand</item>
				<item name="bigbridge_product_urlrewrite" xsi:type="object">BigBridge\ProductImport\Console\Command\ProductUrlRewriteCommand</item>
			</argument>
		</arguments>
	</type>
	<preference for="BigBridge\ProductImport\Api\ProductImportWebApiInterface" type="BigBridge\ProductImport\Api\ProductImportWebApi" />
	<type name="BigBridge\ProductImport\Api\ProductImportWebApi">
		<arguments>
			<!-- web api imports may only read local files from, and cache images in, these directories (absolute, or relative to the Magento root) -->
			<argument name="localFileRoots" xsi:type="array">
				<item name="import" xsi:type="string">pub/media/import</item>
				<item name="product_import" xsi:type="string">var/product-import</item>
			</argument>
		</arguments>
	</type>
</config>